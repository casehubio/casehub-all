<?xml version="1.0" encoding="UTF-8"?>
<!--
  Slice B — Extensions: flow, a2a, mcp, queue, actor-state, watchdog, rest, graphql, etc.
  All depend only on runtime (from base). Independent of slices A and C.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.casehub</groupId>
  <artifactId>casehub-engine-aggregator-slice-b</artifactId>
  <version>0.4-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>CaseHub :: Engine :: Slice B (Extensions)</name>

  <modules>
    <!-- Orchestration extensions -->
    <module>../../engine/flow</module>
    <module>../../engine/a2a</module>
    <module>../../engine/mcp</module>
    <module>../../engine/queue</module>

    <!-- Runtime extensions -->
    <module>../../engine/actor-state</module>
    <module>../../engine/watchdog</module>
    <module>../../engine/casehub-engine-inbound</module>
    <module>../../engine/eidos-routing</module>

    <!-- AI + CBR -->
    <module>../../engine/engine-ai</module>
    <module>../../engine/yaml-cbr</module>

    <!-- REST + GraphQL -->
    <module>../../engine/rest</module>
    <module>../../engine/graphql</module>
  </modules>
</project>
