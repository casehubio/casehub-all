<?xml version="1.0" encoding="UTF-8"?>
<!--
  Slice A — Planning + Resilience + Spring integration.
  react → planning → work-adapter chain, plus resilience and spring-integration-test.
  Independent of slices B and C.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.casehub</groupId>
  <artifactId>casehub-engine-aggregator-slice-a</artifactId>
  <version>0.4-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>CaseHub :: Engine :: Slice A (Planning + Resilience)</name>

  <modules>
    <!-- React (depends on runtime from base) -->
    <module>../../engine/react</module>

    <!-- Planning chain -->
    <module>../../engine/planning</module>
    <module>../../engine/planning-spring</module>

    <!-- Resilience -->
    <module>../../engine/resilience-core</module>
    <module>../../engine/resilience</module>
    <module>../../engine/resilience-spring</module>

    <!-- Work adapters (depend on planning) -->
    <module>../../engine/work-adapter</module>
    <module>../../engine/work-cloudevent</module>

    <!-- Spring integration test (depends on all -spring modules) -->
    <module>../../engine/spring-integration-test</module>
  </modules>
</project>
